# Copy this file to .env and fill in real values. Never commit .env itself.

# Local dev (SQLite): file:./dev.db
# Production (Postgres): postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-real-random-secret"

# Required once this runs behind a reverse proxy (Docker/VPS deployments) so
# NextAuth trusts the forwarded host/proto headers instead of rejecting them.
# Not needed for local dev.
# AUTH_TRUST_HOST=true
