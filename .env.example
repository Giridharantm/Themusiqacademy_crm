# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres — via docker-compose (see README "Deployment"), the format is:
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-real-random-secret"

# WhatsApp Cloud API webhook (/api/whatsapp/webhook). The verify token is any
# long random string you also type into Meta's Webhooks settings; the app
# secret is the "App secret" on the Meta app's Settings > Basic page. Without
# the app secret the webhook refuses every request.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Sending WhatsApp class reminders and notices. The access token is a
# permanent system-user token (Meta Business settings > System users) with the
# whatsapp_business_messaging and whatsapp_business_management permissions;
# the phone number ID is shown on the Meta app's WhatsApp API setup page.
# CRON_SECRET is any long random string; the server's daily 10:00 IST cron job
# sends it to /api/cron/class-reminders. Leave all three empty to switch
# sending off. WHATSAPP_DRY_RUN=1 records messages without sending them.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
CRON_SECRET=""
