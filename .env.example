# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres — via docker-compose (see README "Deployment"), the format is:
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-real-random-secret"

# WhatsApp Cloud API webhook (/api/whatsapp/webhook). The verify token is any
# long random string you also type into Meta's Webhooks settings; the app
# secret is the "App secret" on the Meta app's Settings > Basic page. Without
# the app secret the webhook refuses every request.
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
