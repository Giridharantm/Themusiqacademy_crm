# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres — via docker-compose (see README "Deployment"), the format is:
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-real-random-secret"

# Optional — only needed if using POST /api/attendance/checkin (a
# face-recognition kiosk, an n8n flow, or another automated check-in
# source). Leave unset to disable that endpoint entirely. Generate with:
# node -e "console.log(require('crypto').randomUUID())"
ATTENDANCE_API_KEY=""
