# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres — via docker-compose (see README "Deployment"), the format is:
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Generate with: npx auth secret
AUTH_SECRET="replace-with-a-real-random-secret"

# Required once this runs behind a reverse proxy (Docker/VPS deployments) so
# NextAuth trusts the forwarded host/proto headers instead of rejecting them.
# Not needed for local dev.
# AUTH_TRUST_HOST=true
